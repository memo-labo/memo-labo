# ----------------------------------------
# 404エラーページ
# ----------------------------------------
ErrorDocument 404 /404.php


# ----------------------------------------
# 表示速度改善：静的ファイルのキャッシュ
# 画像は長め、CSS/JSは更新反映も考えて1日
# ----------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# HTML/CSS/JS/SVGなどテキスト系を圧縮
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>


# ----------------------------------------
# URL正規化
# https://memo-labo.com/ に統一
# ----------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # wwwあり → wwwなし
    # http → https
    RewriteCond %{HTTP_HOST} ^www\.memo-labo\.com$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://memo-labo.com/$1 [R=301,L]

    # sitemap.xml はCSVから動的生成し、常に最新の正規URLだけ返す
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # GA4で確認された誤った階層URLを正規URLへ戻す
    # 例: /vtest2.php/1000 → /vtest2.php
    RewriteRule ^(.+\.php)/1000/?$ /$1 [R=301,L,NE]

    # 例: /st.php/index.php → /st.php
    RewriteRule ^(.+\.php)/index\.php/?$ /$1 [R=301,L,NE]

    # 例: /v0.php/zpd.php → /zpd.php
    RewriteRule ^.+\.php/([^/]+\.php)/?$ /$1 [R=301,L,NE]

    # 例: /rpr.php.php → /rpr.php
    RewriteRule ^(.+)\.php\.php/?$ /$1.php [R=301,L,NE]

    # 例: /sog.php/ → /sog.php
    RewriteRule ^(.+\.php)/$ /$1 [R=301,L,NE]
</IfModule>

Redirect 301 /ocr_gimon2.php /ocr_gimon.php
Redirect 301 /ocr3.php /ocr_gimon.php
Redirect 301 /ocr_shiken2.php /ocr_gimon.php
Redirect 301 /ocr_shiken.php /ocr.php
